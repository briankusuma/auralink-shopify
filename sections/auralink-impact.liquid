{{ 'section-auralink-impact.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 40 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
  }
{%- endstyle -%}

<div class="auralink-impact-wrapper color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="auralink-impact-container">
    
    {% comment %} Top Card: Quote, Author & Impact Metrics {% endcomment %}
    <div class="auralink-impact-card">
      <div class="auralink-impact-card-inner">
        
        {% comment %} Author & Quote Row (Figma Node 3069:239) {% endcomment %}
        <div class="auralink-impact-quote-row">
          
          <div class="auralink-impact-author">
            {%- if section.settings.author_image != blank -%}
              {{ section.settings.author_image | image_url: width: 200 | image_tag:
                loading: 'lazy',
                class: 'auralink-impact-author__img',
                alt: section.settings.author_name | default: 'Executive' | escape
              }}
            {%- else -%}
              <img
                src="{{ 'author-dayat.png' | asset_url }}"
                alt="{{ section.settings.author_name | default: 'Executive' | escape }}"
                class="auralink-impact-author__img"
                loading="lazy"
                width="100"
                height="100"
              >
            {%- endif -%}

            <div class="auralink-impact-author__info">
              {%- if section.settings.author_name != blank -%}
                <h3 class="auralink-impact-author__name">{{ section.settings.author_name | escape }}</h3>
              {%- endif -%}
              {%- if section.settings.author_role != blank -%}
                <p class="auralink-impact-author__role">{{ section.settings.author_role | escape }}</p>
              {%- endif -%}
            </div>
          </div>

          <div class="auralink-impact-quote-divider" aria-hidden="true"></div>

          {%- if section.settings.quote_text != blank -%}
            <p class="auralink-impact-quote-text">
              {{ section.settings.quote_text | escape }}
            </p>
          {%- endif -%}

        </div>

        {% comment %} Horizontal Divider (Figma Node 3069:238) {% endcomment %}
        <div class="auralink-impact-divider" aria-hidden="true"></div>

        {% comment %} Metrics Row (Figma Node 3069:340) {% endcomment %}
        <div class="auralink-impact-metrics-row">
          
          {% comment %} Metric 1 {% endcomment %}
          <div class="auralink-impact-metric-item">
            <div class="auralink-impact-metric__box">
              <div class="auralink-impact-metric__badge" aria-hidden="true">
                {%- render 'icon-metric-cube' -%}
              </div>
            </div>
            <div class="auralink-impact-metric__content">
              {%- if section.settings.metric_1_stat != blank -%}
                <p class="auralink-impact-metric__stat">{{ section.settings.metric_1_stat | escape }}</p>
              {%- endif -%}
              {%- if section.settings.metric_1_label != blank -%}
                <p class="auralink-impact-metric__label">{{ section.settings.metric_1_label | escape }}</p>
              {%- endif -%}
            </div>
          </div>

          {% comment %} Metric 2 {% endcomment %}
          <div class="auralink-impact-metric-item">
            <div class="auralink-impact-metric__box">
              <div class="auralink-impact-metric__badge" aria-hidden="true">
                {%- render 'icon-metric-globe' -%}
              </div>
            </div>
            <div class="auralink-impact-metric__content">
              {%- if section.settings.metric_2_stat != blank -%}
                <p class="auralink-impact-metric__stat">{{ section.settings.metric_2_stat | escape }}</p>
              {%- endif -%}
              {%- if section.settings.metric_2_label != blank -%}
                <p class="auralink-impact-metric__label matrict-2">{{ section.settings.metric_2_label | escape }}</p>
              {%- endif -%}
            </div>
          </div>

          {% comment %} Metric 3 {% endcomment %}
          <div class="auralink-impact-metric-item">
            <div class="auralink-impact-metric__box">
              <div class="auralink-impact-metric__badge" aria-hidden="true">
                {%- render 'icon-metric-coins' -%}
              </div>
            </div>
            <div class="auralink-impact-metric__content">
              {%- if section.settings.metric_3_stat != blank -%}
                <p class="auralink-impact-metric__stat">{{ section.settings.metric_3_stat | escape }}</p>
              {%- endif -%}
              {%- if section.settings.metric_3_label != blank -%}
                <p class="auralink-impact-metric__label">{{ section.settings.metric_3_label | escape }}</p>
              {%- endif -%}
            </div>
          </div>

        </div>

      </div>
    </div>

    {% comment %} Bottom Grid: Partner / Logo Grid {% endcomment %}
    <div class="auralink-impact-logos" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="auralink-impact-logo-card" role="listitem" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="auralink-impact-logo-link" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.alt_text | default: 'Partner' | escape }}">
            {%- endif -%}

            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 340 | image_tag:
                loading: 'lazy',
                class: 'auralink-impact-logo-img',
                alt: block.settings.alt_text | default: 'Partner logo' | escape
              }}
            {%- endif -%}

            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {% comment %} Default 8 Figma Partners Fallback {% endcomment %}
        <div class="auralink-impact-logo-card" role="listitem">
          <img src="{{ 'logo-partner-1.svg' | asset_url }}" alt="YesWeHack" class="auralink-impact-logo-img" loading="lazy" width="162" height="35">
        </div>
        <div class="auralink-impact-logo-card" role="listitem">
          <img src="{{ 'logo-partner-2.svg' | asset_url }}" alt="genasys" class="auralink-impact-logo-img" loading="lazy" width="156" height="31">
        </div>
        <div class="auralink-impact-logo-card" role="listitem">
          <img src="{{ 'logo-partner-3.png' | asset_url }}" alt="demostack" class="auralink-impact-logo-img" loading="lazy" width="152" height="23">
        </div>
        <div class="auralink-impact-logo-card" role="listitem">
          <img src="{{ 'logo-partner-4.png' | asset_url }}" alt="paymongo" class="auralink-impact-logo-img" loading="lazy" width="165" height="29">
        </div>
        <div class="auralink-impact-logo-card" role="listitem">
          <img src="{{ 'logo-partner-5.png' | asset_url }}" alt="LABEL" class="auralink-impact-logo-img" loading="lazy" width="168" height="32">
        </div>
        <div class="auralink-impact-logo-card" role="listitem">
          <img src="{{ 'logo-partner-6.svg' | asset_url }}" alt="medatus" class="auralink-impact-logo-img" loading="lazy" width="134" height="45">
        </div>
        <div class="auralink-impact-logo-card" role="listitem">
          <img src="{{ 'logo-partner-7.svg' | asset_url }}" alt="Renee" class="auralink-impact-logo-img" loading="lazy" width="111" height="27">
        </div>
        <div class="auralink-impact-logo-card" role="listitem">
          <img src="{{ 'logo-partner-8.svg' | asset_url }}" alt="sprinter health" class="auralink-impact-logo-img" loading="lazy" width="135" height="34">
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Impact story",
  "tag": "section",
  "class": "section-auralink-impact",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Author Information"
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Author portrait"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author name",
      "default": "Dr. Dayat Santoso"
    },
    {
      "type": "text",
      "id": "author_role",
      "label": "Author role or title",
      "default": "CEO of NexaTech Innovations"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote text",
      "default": "“The integration of AI into smart home devices is revolutionizing how we interact with our living spaces. These technologies not only bring unprecedented convenience but also optimize energy use.”"
    },
    {
      "type": "header",
      "content": "Metric 1"
    },
    {
      "type": "text",
      "id": "metric_1_stat",
      "label": "Statistic value",
      "default": "80M+"
    },
    {
      "type": "text",
      "id": "metric_1_label",
      "label": "Description label",
      "default": "Product Launched over worldwide"
    },
    {
      "type": "header",
      "content": "Metric 2"
    },
    {
      "type": "text",
      "id": "metric_2_stat",
      "label": "Statistic value",
      "default": "50+"
    },
    {
      "type": "text",
      "id": "metric_2_label",
      "label": "Description label",
      "default": "Countries connected to our ecosystem"
    },
    {
      "type": "header",
      "content": "Metric 3"
    },
    {
      "type": "text",
      "id": "metric_3_stat",
      "label": "Statistic value",
      "default": "$120M+"
    },
    {
      "type": "text",
      "id": "metric_3_label",
      "label": "Description label",
      "default": "raised in Series B funding"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "partner_logo",
      "name": "Partner Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Partner website link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Partner name or alt text",
          "default": "Partner"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Impact story"
    }
  ]
}
{% endschema %}
