{{ 'section-auralink-cta.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 48 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
  }
{%- endstyle -%}

<div class="auralink-cta-wrapper color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="auralink-cta-container{% if section.settings.layout == 'text_left' %} auralink-cta-container--text-left{% else %} auralink-cta-container--text-right{% endif %}">
    
    {% comment %} Left Column: Hand Holding Smart Device Image {% endcomment %}
    <div class="auralink-cta__media-col">
      <div class="auralink-cta__image-wrap">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 960
            | image_tag:
              loading: 'lazy',
              class: 'auralink-cta__image',
              widths: '400, 600, 800, 960',
              alt: section.settings.heading | escape
          }}
        {%- elsif section.settings.default_image != blank -%}
          <img
            src="{{ section.settings.default_image | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            class="auralink-cta__image"
            loading="lazy"
            width="478"
            height="509"
          >
        {%- endif -%}
      </div>
    </div>

    {% comment %} Right Column: CTA Card Content {% endcomment %}
    <div class="auralink-cta__card">
      <div class="auralink-cta__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="auralink-cta__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="auralink-cta__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      <div class="auralink-cta__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="auralink-cta__btn">
            <span>{{ section.settings.button_label | escape }}</span>
            <span class="auralink-cta__btn-icon" aria-hidden="true">
              {% render 'icon-slider-arrow' %}
            </span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_badge -%}
          <div class="auralink-cta__badge" aria-hidden="true">
            {% render 'icon-cta-asterisk' %}
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Call to action",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "text_right",
          "label": "Text on right, image on left"
        },
        {
          "value": "text_left",
          "label": "Text on left, image on right"
        }
      ],
      "default": "text_right"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Device Image"
    },
    {
      "type": "text",
      "id": "default_image",
      "label": "Default Asset Image",
      "default": "cta-card-composite.png"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your Journey to Smarter Living Starts with One Click."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover AI-powered devices that adapt to your lifestyle—bringing comfort, security, and efficiency to every corner of your home."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get started"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show decorative badge",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Call to action",
      "settings": {
        "heading": "Your Journey to Smarter Living Starts with One Click.",
        "subheading": "Discover AI-powered devices that adapt to your lifestyle—bringing comfort, security, and efficiency to every corner of your home.",
        "button_label": "Get started",
        "default_image": "cta-card-composite.png",
        "show_badge": true
      }
    }
  ]
}
{% endschema %}
