{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width section-{{ section.id }}-padding">
    {%- if section.settings.tag != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="auralink-contact__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.tag != blank -%}
          <div class="auralink-contact__tag-wrap">
            <span class="auralink-pill">
              <span class="auralink-pill__dot" aria-hidden="true"></span>
              {{ section.settings.tag | escape }}
            </span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }} auralink-contact__title">
            {{ section.settings.heading }}
          </h2>
        {%- else -%}
          <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="auralink-contact__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}

    <div class="auralink-contact-grid{% if section.blocks.size > 0 %} auralink-contact-grid--with-sidebar{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.blocks.size > 0 -%}
        <div class="auralink-contact-sidebar">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'contact_card' -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="auralink-contact-info-card" {{ block.shopify_attributes }}>
                {%- else -%}
                  <div class="auralink-contact-info-card" {{ block.shopify_attributes }}>
                {%- endif -%}

                  <div class="auralink-contact-info-card__top">
                    <div class="auralink-contact-info-card__icon-wrap" aria-hidden="true">
                      {%- case block.settings.icon -%}
                        {%- when 'mail' -%}
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                          </svg>
                        {%- when 'phone' -%}
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                          </svg>
                        {%- when 'chat' -%}
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
                          </svg>
                        {%- when 'clock' -%}
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                          </svg>
                        {%- when 'location' -%}
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                            <circle cx="12" cy="10" r="3"/>
                          </svg>
                        {%- else -%}
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                          </svg>
                      {%- endcase -%}
                    </div>
                    {%- if block.settings.badge != blank -%}
                      <span class="auralink-contact-info-card__badge">{{ block.settings.badge | escape }}</span>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.heading != blank -%}
                    <h3 class="auralink-contact-info-card__title">{{ block.settings.heading | escape }}</h3>
                  {%- endif -%}

                  {%- if block.settings.content != blank -%}
                    <div class="auralink-contact-info-card__content rte">
                      {{ block.settings.content }}
                    </div>
                  {%- endif -%}

                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="auralink-contact-card">
        {%- liquid
          assign contact_form_class = 'isolate auralink-contact-form'
        -%}
        {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
          {%- if form.posted_successfully? -%}
            <div class="form-status form-status-list form__message" tabindex="-1" autofocus>
              <span class="svg-wrapper">
                {{- 'icon-success.svg' | inline_asset_content -}}
              </span>
              <span>{{ 'templates.contact.form.post_success' | t }}</span>
            </div>
          {%- elsif form.errors -%}
            <div class="form__message form__message--error" role="alert" tabindex="-1" autofocus>
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
              <div>
                <h2 class="form-status caption-large text-body">
                  {{ 'templates.contact.form.error_heading' | t }}
                </h2>
                <ul class="form-status-list caption-large" role="list">
                  <li>
                    <a href="#ContactForm-email" class="link">
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          {%- endif -%}

          <div class="contact__fields">
            <div class="field">
              <input
                class="field__input"
                autocomplete="name"
                type="text"
                id="ContactForm-name"
                name="contact[{{ 'templates.contact.form.name' | t }}]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ 'templates.contact.form.name' | t }}"
                required
              >
              <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }} *</label>
            </div>
            <div class="field{% if form.errors contains 'email' %} field--with-error{% endif %}">
              <input
                autocomplete="email"
                type="email"
                id="ContactForm-email"
                class="field__input"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactForm-email-error"
                {% endif %}
                placeholder="{{ 'templates.contact.form.email' | t }}"
              >
              <label class="field__label" for="ContactForm-email">
                {{- 'templates.contact.form.email' | t }}
                <span aria-hidden="true">*</span>
              </label>
              {%- if form.errors contains 'email' -%}
                <small class="contact__field-error" id="ContactForm-email-error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  <span class="form__message">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </span>
                </small>
              {%- endif -%}
            </div>
          </div>

          {%- if section.settings.show_phone -%}
            <div class="field">
              <input
                type="tel"
                id="ContactForm-phone"
                class="field__input"
                autocomplete="tel"
                name="contact[{{ 'templates.contact.form.phone' | t }}]"
                pattern="[0-9\-+ ]*"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="{{ 'templates.contact.form.phone' | t }}"
              >
              <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
            </div>
          {%- endif -%}

          <div class="field contact__field-textarea">
            <textarea
              rows="6"
              id="ContactForm-body"
              class="text-area field__input"
              name="contact[{{ 'templates.contact.form.comment' | t }}]"
              placeholder="{{ 'templates.contact.form.comment' | t }}"
              required
            >
              {{- form.body -}}
            </textarea>
            <label class="form__label field__label" for="ContactForm-body">
              {{- 'templates.contact.form.comment' | t -}} *
            </label>
          </div>

          {%- if section.settings.show_terms -%}
            <div class="auralink-contact__terms">
              <label class="auralink-checkbox-label" for="ContactForm-terms">
                <input
                  type="checkbox"
                  id="ContactForm-terms"
                  name="contact[terms]"
                  value="accepted"
                  class="auralink-checkbox-input"
                  required
                >
                <span class="auralink-checkbox-custom" aria-hidden="true">
                  <svg viewBox="0 0 12 10" fill="none" class="auralink-checkbox-icon">
                    <path d="M1 5L4.5 8.5L11 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="auralink-checkbox-text">
                  {%- if section.settings.terms_text != blank -%}
                    {{ section.settings.terms_text }}
                  {%- else -%}
                    I accept the Terms and Privacy Policy.
                  {%- endif -%}
                </span>
              </label>
            </div>
          {%- endif -%}

          <div class="contact__button">
            <button type="submit" class="auralink-contact-btn button">
              <span>{{ 'templates.contact.form.send' | t }}</span>
              <span class="auralink-contact-btn__icon" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3.125 11.875L11.875 3.125M11.875 3.125H5M11.875 3.125V10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag badge",
      "default": "Support & Inquiries"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Have questions about AuraLink products or need assistance with your order? Our team is always ready to assist.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone number field",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_terms",
      "label": "Show terms agreement checkbox",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "terms_text",
      "label": "Terms text",
      "default": "I accept the Terms and Privacy Policy."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "contact_card",
      "name": "Contact card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "mail",
              "label": "Email"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "clock",
              "label": "Hours"
            },
            {
              "value": "location",
              "label": "Location"
            }
          ],
          "default": "mail"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "default": "24/7 Response"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Email Support"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>support@auralink.com<br>We answer within 24 hours.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name",
      "blocks": [
        {
          "type": "contact_card",
          "settings": {
            "icon": "mail",
            "badge": "24/7 Response",
            "heading": "Email Support",
            "content": "<p>support@auralink.com<br>We respond within 24 hours.</p>"
          }
        },
        {
          "type": "contact_card",
          "settings": {
            "icon": "chat",
            "badge": "Mon - Fri",
            "heading": "Live Assistance",
            "content": "<p>9:00 AM – 6:00 PM EST<br>Direct messaging with specialists.</p>"
          }
        },
        {
          "type": "contact_card",
          "settings": {
            "icon": "location",
            "badge": "Headquarters",
            "heading": "Global Office",
            "content": "<p>San Francisco, CA<br>Worldwide delivery & support.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
