{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Shopify Theme Check 4.9.4 (including warnings)",
      "type": "process",
      "command": "npm",
      "args": [
        "exec", "--yes", "--package", "@shopify/cli@4.9.4", "--",
        "shopify", "theme", "check", "--fail-level", "warning"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
